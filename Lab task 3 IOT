# Question No1

# Ask the user for the marks of 5 subjects.

# Calculate:
    # Total marks
    # Percentage
    # Grade
    # Pass/Fail

# Use a loop to enter the marks.


total = 0
failed = False

for i in range(1, 6):
    marks = float(input(f"Enter marks for subject {i}: "))

    total = total + marks

    if marks < 40:
        failed = True

percentage = (total / 500) * 100

if percentage >= 80:
    grade = "A+"
elif percentage >= 70:
    grade = "A"
elif percentage >= 60:
    grade = "B"
elif percentage >= 50:
    grade = "C"
elif percentage >= 40:
    grade = "D"
else:
    grade = "F"

if failed:
    result = "Fail"
else:
    result = "Pass"

print("\nTotal:", total)
print("Percentage:", percentage)
print("Grade:", grade)
print("Result:", result)




